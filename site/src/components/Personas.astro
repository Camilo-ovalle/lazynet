import Icon from "./Icon.astro";
import { personas } from "../data/content";
---
<section class="section" id="features">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Why lazynet</span>
      <h2>The answers you need, without the SSH archaeology</h2>
      <p>
        "What VLAN is that port in?" "What happened on this switch last night?" lazynet puts everyday
        questions behind one fast interface, for every Cisco platform you run.
      </p>
    </div>
    <div class="cards">
      {personas.map((p) => (
        <article class="card">
          <span class="icon"><Icon name={p.icon as "terminal"} size={22} /></span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .card {
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s, transform 0.2s;
  }
  .card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: var(--mint);
    background: var(--mint-glow);
    border: 1px solid rgb(63 224 160 / 0.25);
  }
  h3 {
    margin-top: 20px;
    font-size: 20px;
    font-weight: 750;
  }
  p {
    margin-top: 10px;
    color: var(--muted);
    font-size: 16px;
  }
  @media (max-width: 900px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
