#
# Shared look for every recording: brand palette, JetBrains Mono, window frame.
# Sourced by the other tapes, which run from the repository root.
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set FontSize 15
Set Width 1440
Set Height 860
Set Padding 18
Set Margin 0
Set WindowBar Colorful
Set BorderRadius 12
Set Framerate 30
Set TypingSpeed 75ms
Set Theme { "name": "lazynet", "background": "#121821", "foreground": "#F3F5F2", "cursor": "#FFB547", "selection": "#2A3542", "black": "#121821", "red": "#FF6B6B", "green": "#87D787", "yellow": "#FFD75F", "blue": "#87AFFF", "magenta": "#D787FF", "cyan": "#5FD7AF", "white": "#E4E4E4", "brightBlack": "#3A4554", "brightRed": "#FF8787", "brightGreen": "#3FE0A0", "brightYellow": "#FFB547", "brightBlue": "#5FAFFF", "brightMagenta": "#D787FF", "brightCyan": "#5FD7AF", "brightWhite": "#F3F5F2" }
