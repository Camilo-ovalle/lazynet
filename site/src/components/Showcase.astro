import Icon from "./Icon.astro";
import Media from "./Media.astro";
import { showcase } from "../data/content";
---
<section class="section" id="tui">
  <div class="container rows">
    {showcase.map((s, i) => (
      <div class:list={["row", { flip: i % 2 === 1 }]}>
        <div class="text">
          <span class="eyebrow">{s.eyebrow}</span>
          <h2>{s.title}</h2>
          <p>{s.text}</p>
          <ul>
            {s.points.map((pt) => (
              <li><span class="tick"><Icon name="check" size={16} /></span>{pt}</li>
            ))}
          </ul>
        </div>
        <div class="media">
          <Media name={s.media} poster={s.poster} alt={s.alt} />
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .rows {
    display: flex;
    flex-direction: column;
    gap: clamp(72px, 10vw, 128px);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }
  .row.flip .text {
    order: 2;
  }
  h2 {
    margin-top: 14px;
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 800;
  }
  p {
    margin-top: 16px;
    color: var(--muted);
    font-size: 17px;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  li {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--text-2);
    font-weight: 550;
  }
  .tick {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    color: var(--mint);
    background: var(--mint-glow);
    flex: none;
  }
  .media {
    min-width: 0;
  }
  @media (max-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    .row.flip .text {
      order: 0;
    }
  }
</style>
