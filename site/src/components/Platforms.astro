---
// Copyright 2026 Camilo Enrique Ovalle Ceron
// SPDX-License-Identifier: Apache-2.0
// Platform names as text badges (no vendor logos: they are trademarks).
const platforms = [
  { badge: "CAT", cls: "cat", name: "Catalyst", os: "IOS · IOS-XE" },
  { badge: "NXS", cls: "nxs", name: "Nexus", os: "NX-OS" },
  { badge: "ASA", cls: "asa", name: "ASA", os: "ASA OS" },
  { badge: "PAN", cls: "pan", name: "Palo Alto", os: "PAN-OS" },
];
---
<section class="strip" aria-label="Supported platforms">
  <div class="container inner">
    <p class="label">Detects and speaks to</p>
    <ul class="list">
      {platforms.map((p) => (
        <li>
          <span class={`badge badge--${p.cls}`}>{p.badge}</span>
          <span class="name">{p.name}</span>
          <span class="os">{p.os}</span>
        </li>
      ))}
      <li class="runs">
        <span class="name">Runs on Linux</span>
        <span class="os">amd64 · arm64</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .strip {
    border-block: 1px solid rgb(42 53 66 / 0.6);
    background: var(--bg-2);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 28px 48px;
    flex-wrap: wrap;
    padding-block: 26px;
  }
  .label {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .list {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }
  li {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .name {
    color: var(--text);
    font-weight: 700;
    font-size: 18px;
  }
  .os {
    color: var(--muted);
    font-size: 14px;
  }
  .runs {
    margin-left: auto;
  }
  @media (max-width: 760px) {
    .runs {
      margin-left: 0;
    }
  }
</style>
