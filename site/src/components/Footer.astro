import { repo } from "../data/content";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const cols = [
  { title: "Product", links: [["Features", "#features"], ["Install", "#install"], ["Safety model", "#safety"], ["Releases", `${repo}/releases`]] },
  { title: "Docs", links: [["README", `${repo}#readme`], ["Configuration", `${repo}#configuration`], ["Troubleshooting", `${repo}#troubleshooting`], ["Releasing", `${repo}/blob/main/docs/releasing.md`]] },
  { title: "Community", links: [["GitHub", repo], ["Report an issue", `${repo}/issues`], ["Español", `${repo}/blob/main/README.es.md`]] },
];
---
<footer class="footer">
  <div class="container top">
    <div class="brand">
      <img src={`${base}brand/lazynet-lockup-dark-transparent.svg`} alt="lazynet" width="132" height="40" loading="lazy" />
      <p>A lazy terminal UI and CLI for Cisco Catalyst, Nexus and ASA.</p>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.title}>
        <h2>{c.title}</h2>
        <ul>
          {c.links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <div class="container">
    <div class="legal">
    <p>© 2026 Camilo Enrique Ovalle Ceron · Licensed under <a href={`${repo}/blob/main/LICENSE`}>Apache-2.0</a></p>
    <p>lazynet is an independent project, not affiliated with or endorsed by Cisco Systems, Inc. or Palo Alto Networks, Inc. Cisco, Catalyst and Nexus are trademarks of Cisco Systems, Inc. Palo Alto Networks and PAN-OS are trademarks of Palo Alto Networks, Inc.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-2);
    padding-top: 64px;
  }
  .top {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 40px;
  }
  .brand img {
    height: 32px;
    width: auto;
  }
  .brand p {
    margin-top: 16px;
    max-width: 280px;
    color: var(--muted);
    font-size: 15px;
  }
  h2 {
    font-size: 13px;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text);
  }
  ul {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  ul a {
    color: var(--muted);
    font-size: 15px;
  }
  ul a:hover {
    color: var(--text);
  }
  .legal {
    margin-top: 56px;
    padding-block: 24px 32px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13.5px;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
