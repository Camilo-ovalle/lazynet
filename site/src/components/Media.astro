---
// Copyright 2026 Camilo Enrique Ovalle Ceron
// SPDX-License-Identifier: Apache-2.0
// A terminal recording (VHS, rendered by the pages workflow into public/media/)
// with the static mockup as poster. If the recording is missing, as in local
// development, the poster shows instead.
import { existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

interface Props {
  name: string;
  poster: string;
  alt: string;
  width?: number;
  height?: number;
  eager?: boolean;
}
const { name, poster, alt, width = 1440, height = 860, eager = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const publicDir = fileURLToPath(new URL("../../public/", import.meta.url));
const hasVideo = existsSync(`${publicDir}media/${name}.webm`) || existsSync(`${publicDir}media/${name}.mp4`);
---
{hasVideo ? (
  <video
    class="shot"
    data-autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={`${base}${poster}`}
    width={width}
    height={height}
    aria-label={alt}
  >
    <source src={`${base}media/${name}.webm`} type="video/webm" />
    <source src={`${base}media/${name}.mp4`} type="video/mp4" />
  </video>
) : (
  <img class="shot" src={`${base}${poster}`} alt={alt} width={width} height={height} loading={eager ? "eager" : "lazy"} decoding="async" fetchpriority={eager ? "high" : "auto"} />
)}

<style>
  .shot {
    width: 100%;
    height: auto;
    border-radius: 14px;
    box-shadow:
      0 0 0 1px rgb(42 53 66 / 0.9),
      0 30px 80px -20px rgb(0 0 0 / 0.7);
  }
</style>
