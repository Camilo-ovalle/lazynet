import Icon from "./Icon.astro";
import { guarantees, repo } from "../data/content";
const icons = ["eye", "check", "list", "key", "lock", "user"] as const;
---
<section class="section section--alt" id="safety">
  <div class="container">
    <div class="section-head section-head--center">
      <span class="eyebrow">Safety model</span>
      <h2>Safe to hand to anyone on your team</h2>
      <p>
        These guarantees are enforced in code, not by convention. lazynet is read-only by design, and
        its single kind of change is guarded at every step.
      </p>
    </div>
    <div class="grid">
      {guarantees.map((g, i) => (
        <article class="item">
          <span class="icon"><Icon name={icons[i % icons.length]} size={20} /></span>
          <div>
            <h3>{g.title}</h3>
            <p>{g.text}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="more">
      <a href={`${repo}#safety-model`}>Read the full safety model <span aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .item {
    display: flex;
    gap: 16px;
    padding: 28px;
    background: var(--bg-2);
  }
  .icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--amber);
    background: var(--amber-glow);
    border: 1px solid rgb(255 181 71 / 0.22);
  }
  h3 {
    font-size: 17px;
    font-weight: 750;
  }
  p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 15px;
  }
  .more {
    margin-top: 28px;
    text-align: center;
    font-weight: 600;
  }
  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
